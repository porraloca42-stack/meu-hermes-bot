# Copy into HERMES_HOME/config.yaml after reviewing against the installed Hermes version.
memory:
  memory_enabled: true
  user_profile_enabled: true
  write_approval: false

skills:
  write_approval: true

agent:
  tool_use_enforcement: "auto"
  execution_guidance: "auto"

tool_loop_guardrails:
  warnings_enabled: true
  non_interactive_hard_stop_enabled: true

display:
  memory_notifications: "verbose"

nous:
  guest: true
